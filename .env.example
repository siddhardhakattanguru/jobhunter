# Copy to .env and fill in. Never commit .env. No quotes, no spaces around "=".

# Gemini (has a free tier) - get a key at https://aistudio.google.com
GEMINI_API_KEY=
# If the default model is retired or not on your free tier, set another:
# GEMINI_MODEL=gemini-3.8-flash

# Optional: use Claude instead (paid API, console key)
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5

# Optional: Adzuna job search API (free tier) - https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
